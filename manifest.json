{
  "name": "Text Transform Extension",
  "description": "Transforms Japanese text on web pages with ordered rules and morphological analysis.",
  "version": "1.5",
  "manifest_version": 3,
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-current-tab": {
      "description": "Temporarily toggle the extension on the current tab"
    },
    "toggle-global-extension": {
      "description": "Temporarily toggle the extension globally"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/json5.min.js",
        "lib/kuromoji.js",
        "transform-shared.js",
        "transform-engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "transform-bundles.json5",
        "transform-shared.js",
        "transforms/**",
        "dict/**"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
