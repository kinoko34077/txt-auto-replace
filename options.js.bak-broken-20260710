  const applyImportPayloadToTarget = (payload, explicitTargetNodeId = null) => {
    const targetNodeId = explicitTargetNodeId ?? state.bundleUi.selectedNodeId;
    if (!targetNodeId || targetNodeId === "__all__") {
      setStatus("Select a target node before importing.", "error");
      return false;
