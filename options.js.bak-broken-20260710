        ? source.groups
        : [];

    return {
      id: `${source?.id ?? createNodeId()}`.trim() || fallbackId,
      label: `${source?.label ?? fallbackLabel}`.trim() || fallbackLabel,
      kind: `${inferBundleKind(source)}`.trim() || "dictionary-rules",
      enabled: source?.enabled !== false,
      selected: source?.selected === true,
