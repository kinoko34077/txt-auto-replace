    if (!targetNode || !sourceNode) {
      return;
    }
    targetNode.entries.push(...(sourceNode.entries ?? []).map((entry) => createDeepEntryClone(entry)));
    for (const sourceChild of sourceNode.children ?? []) {
      const matchedChild = findMatchingNodeByIdOrLabel(targetNode.children ?? [], sourceChild);
      if (matchedChild) {
        mergeImportedNodeIntoTarget(matchedChild, sourceChild);
      } else {
        targetNode.children.push(createDeepNodeClone(sourceChild));
