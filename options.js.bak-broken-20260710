    const tokenTexts = [];
    let current = "";
    let braceDepth = 0;
    for (const char of trimmed) {
      if (char === "{") {
        braceDepth += 1;
        current += char;
        continue;
      }
      if (char === "}") {
        braceDepth = Math.max(0, braceDepth - 1);
        current += char;
        continue;
      }
      if (/\s/.test(char) && braceDepth === 0) {
        if (current.trim()) {
          tokenTexts.push(current.trim());
          current = "";
