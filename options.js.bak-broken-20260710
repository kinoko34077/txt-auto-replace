          }
        } else {
          state.roots.splice(targetLocation.index + 1, 0, createDeepNodeClone(sourceNode));
        }
        return true;
      }

      if (mode === "split-into-child-box") {
        let childBox = targetNode.children.find((child) => child.label === sourceNode.label) ?? null;
        if (!childBox) {
          childBox = createImportSplitBox(sourceNode);
          targetNode.children.push(childBox);
        }
        mergeImportedNodeIntoTarget(childBox, sourceNode);
        return true;
      }

      if (mode === "merge-matched") {
        const matchedChild = findMatchingNodeByIdOrLabel(targetNode.children ?? [], sourceNode);
        if (matchedChild) {
          mergeImportedNodeIntoTarget(matchedChild, sourceNode);
        } else {
          targetNode.children.push(createDeepNodeClone(sourceNode));
