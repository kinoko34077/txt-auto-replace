    const targetLocation = findNodeLocation(targetNodeId);
    if (!targetLocation) {
      setStatus("Target node not found.", "error");
      return false;
    }
    const targetNode = targetLocation.node;
    const mode = state.importSession?.options?.mode ?? "merge-matched";

    return runStateTransaction("Apply staged import", () => {
      if (payload.type === "import-entry") {
        const sourceEntry = findImportEntry(payload.sourceNodeId, payload.entryId);
        if (!sourceEntry) {
          return false;
        }
        if (mode === "split-into-child-box") {
          const boxLabel = payload.sourceLabel || payload.sourceNodeLabel || "Imported";
          let childBox = targetNode.children.find((child) => child.label === boxLabel) ?? null;
          if (!childBox) {
            childBox = createImportSplitBox({ label: boxLabel, kind: targetNode.kind });
            targetNode.children.push(childBox);
          }
          childBox.entries.push(createDeepEntryClone(sourceEntry));
          applySafeAutoMergesToNode(childBox);
        } else {
          targetNode.entries.push(createDeepEntryClone(sourceEntry));
          applySafeAutoMergesToNode(targetNode);
        }
        return true;
      }

      if (payload.type !== "import-node") {
        return false;
      }

      const sourceLocation = findImportNodeLocation(payload.sourceNodeId);
      if (!sourceLocation) {
        return false;
      }
      const sourceNode = sourceLocation.node;
      const sourceIsRoot = !sourceLocation.parentNode;
      const targetIsRoot = !targetLocation.parentNode;

      if (sourceIsRoot && targetIsRoot && mode !== "split-into-child-box") {
        if (mode === "merge-matched") {
          const matchedRoot = findMatchingNodeByIdOrLabel(state.roots, sourceNode);
          if (matchedRoot) {
            mergeImportedNodeIntoTarget(matchedRoot, sourceNode);
