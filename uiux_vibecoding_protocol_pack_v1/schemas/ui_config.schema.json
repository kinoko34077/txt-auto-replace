{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Config Schema",
  "type": "object",
  "properties": {
    "density": {
      "enum": [
        "compact",
        "normal",
        "spacious"
      ]
    },
    "controlHeight": {
      "type": "object"
    },
    "layout": {
      "type": "object"
    },
    "actions": {
      "type": "object"
    },
    "forms": {
      "type": "object"
    },
    "accessibility": {
      "type": "object"
    }
  },
  "required": [
    "density",
    "layout",
    "actions",
    "forms",
    "accessibility"
  ]
}
